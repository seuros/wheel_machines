module WheelMachines
  VERSION: String
  CAPACITY: Integer
  MAX_CASCADES: Integer

  # Both fields are Integers in 0..2**64-1: TypeError for a non-Integer,
  # RangeError outside the range.
  class Due < Data
    attr_reader id: Integer
    attr_reader deadline: Integer
    def self.new: (Integer id, Integer deadline) -> Due
                | (id: Integer, deadline: Integer) -> Due
  end

  # Validated by the core's `Drain::new`: TypeError when `due` is not an
  # Array of Due or `status` not a Symbol; RangeError for an unknown status, a
  # negative `cascaded`, or work past the core's usize. `due` is stored as a
  # frozen copy.
  class Drain < Data
    type status = :caught_up | :output_full | :budget_spent

    attr_reader due: Array[Due]
    attr_reader cascaded: Integer
    attr_reader status: status
    def self.new: (Array[Due] due, Integer cascaded, status status) -> Drain
                | (due: Array[Due], cascaded: Integer, status: status) -> Drain
    # The core's `emitted`: how many entries are in `due`.
    def emitted: () -> Integer
    def work: () -> Integer
    def caught_up?: () -> bool
  end

  # Mirrors the core's `Handle`: names one registration on the wheel that
  # issued it and carries that wheel's scope. Opaque; it cannot be built or
  # copied by hand. A wheel in another scope answers :stale to it.
  class Handle
    # The scope of the wheel that issued it, 0..65535.
    def scope: () -> Integer
  end

  class Wheel
    # Tick zero, scope zero, nothing issued.
    def self.new: () -> Wheel
    # Tick zero. `scope` is an Integer in 0..65535: TypeError otherwise,
    # RangeError outside the range.
    def self.with_scope: (Integer scope) -> Wheel
    def self.starting_at: (Integer scope, Integer now) -> Wheel
    # Continues `scope` after a restart from a saved `issued` count. Restores
    # only the handle sequence: the wheel is empty. RangeError when `issued`
    # is above 2**48 - 1.
    def self.resumed: (Integer scope, Integer issued, Integer now) -> Wheel
    # The scope carried by every Handle this wheel issues.
    def scope: () -> Integer
    # Handles issued in this scope so far: the count to save for `resumed`.
    def issued: () -> Integer
    def capacity: () -> Integer
    def size: () -> Integer
    def empty?: () -> bool
    def now: () -> Integer
    def next_wake: () -> Integer?
    # Refusals are symbols, one per core variant, and a refused call changes
    # nothing. `Refusal::Regressed { now }` is `:regressed`; the tick it
    # carries is `now`.
    # Honoured: a Handle. Refused: :elapsed, :full, :exhausted.
    def register: (Integer id, Integer deadline) -> (Handle | :elapsed | :full | :exhausted)
    # Honoured: the id that was registered. Refused: :stale, a Handle from a
    # wheel in another scope included.
    def cancel: (Handle) -> (Integer | :stale)
    # nil for a Handle that names no live registration here.
    def deadline: (Handle) -> Integer?
    # Honoured: :advanced (repeating the current tick included). Records
    # `now`: the answer depends on it. Refused: :regressed.
    def advance: (Integer now) -> (:advanced | :regressed)
    # Never refuses and records no clock: it drains against `now`. A budget
    # or limit past usize raises RangeError before anything is drained.
    def drain: (Integer budget, Integer limit) -> Drain
    # Honoured: a Drain; records `now`. Refused: :regressed. A budget or
    # limit past usize raises RangeError before the tick moves.
    def tick: (Integer now, Integer budget, Integer limit) -> (Drain | :regressed)
  end
end
